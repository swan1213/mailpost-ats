# Amazon SES. Create an IAM user with the policy in docs/aws-iam-policy.json and paste its access key here.
# The MAIL_FROM domain must be verified in SES in this region. On start-up the app creates the configuration
# set, SNS topic + SQS queue for delivery events, and the unsubscribe contact list by itself.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: set to 0 if you create the SES resources yourself (default 1 = the app creates them)
SES_AUTO_SETUP=
# Optional: resource names (defaults: mailpost, mailpost-ses-events, mailpost-ses-events, mailpost, outreach).
# If you change the topic or queue name, change it in docs/aws-iam-policy.json too.
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC=
SES_EVENTS_QUEUE=
SES_CONTACT_LIST=
SES_UNSUBSCRIBE_TOPIC=
# Optional: open tracking, 1 = on (default), 0 = off
SES_TRACK_OPENS=

# Sender identity
MAIL_FROM=
REPLY_TO=

# Branding for the HTML email layout
BRAND_NAME=
BRAND_URL=
# Logo must be PNG/JPG on a public URL (email apps don't show SVG)
BRAND_LOGO_URL=
BRAND_TAGLINE=
BRAND_LOCATION=
BRAND_ESTABLISHED=

# Sending
# Folder for CSV files (uploads are saved here; Re-import re-reads it)
CSV_DIR=
# Tag and campaign put on every email (status tracking reads this tag)
CAMPAIGN_TAG=
# Starting values for the dashboard Settings tab (used on first run only; after that, edit them in the UI)
# Template is used when a CSV row has an empty subject ({name} and {email} are replaced)
TEMPLATE_FILE=
TEMPLATE_SUBJECT=
# Wait between emails = DELAY_SECONDS + random 1..DELAY_RANDOM_MAX seconds
DELAY_SECONDS=
DELAY_RANDOM_MAX=
# 0 = no daily cap
DAILY_LIMIT=
MAX_ATTEMPTS=
# How often to read delivery/open events from SES (the SQS queue)
EVENTS_POLL_SECONDS=

# Starting value for the test address (editable in Settings)
TEST_EMAIL=

# Dashboard
HOST=
PORT=
DB_FILE=

# Windows notification when sending pauses (1 = on, 0 = off) and the link it opens
DESKTOP_NOTIFICATIONS=
DASHBOARD_URL=
